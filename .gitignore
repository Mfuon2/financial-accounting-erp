# ── Maven / Spring Boot ───────────────────────────────────────────────────────
fa-backend/target/
fa-backend/*.log
fa-backend/.mvn/wrapper/maven-wrapper.jar

# ── Node / Vite ───────────────────────────────────────────────────────────────
fa-frontend/node_modules/
fa-frontend/dist/
fa-frontend/.vite/
fa-frontend/.env
fa-frontend/.env.local
fa-frontend/.env.*.local

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
*.env
application-local.properties
application-secrets.properties
fa-backend/src/main/resources/application.properties

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker volumes / data ─────────────────────────────────────────────────────
# NOTE: docker-compose.yml uses named Docker volumes (postgres_data, redis_data, ...), not host
# bind-mounts, so no bind-mounted directory actually needs ignoring here. A bare `data/` pattern
# used to be here and — because gitignore patterns with no leading `/` match at any depth — it was
# unintentionally also matching and un-tracking fa-frontend/src/data/index.js, the real source file
# every demo-mode view depends on (COA, customers, invoices, budgets, ... fixtures). Found and fixed
# 2026-08-09 while adding Budget demo fixtures and discovering they wouldn't actually commit.
postgres-data/
